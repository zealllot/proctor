#!/usr/bin/env bash
# Generic local-dev launcher template generated by PRoctor's /proctor:proctor-init.
# Adapt this to your project. Rename to whatever your team prefers (./dev.sh, ./run.sh, etc.).
#
# Usage:
#   ./dev-launcher-template.sh setup      First-time setup (env files, deps, etc.)
#   ./dev-launcher-template.sh up         Start full local dev environment
#   ./dev-launcher-template.sh down       Stop everything
#   ./dev-launcher-template.sh status     Show what's running
#   ./dev-launcher-template.sh logs <n>   Tail a background process log
#
# After filling in the TODOs, configure PRoctor to use this script:
#
#   # .proctor/config.yml
#   dev_launcher:
#     start: ./dev-launcher-template.sh up
#     stop: ./dev-launcher-template.sh down
#     wait_for: <bash command that exits 0 when env ready>
#     wait_timeout_seconds: 90

set -euo pipefail
ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$ROOT_DIR/.dev-logs"
mkdir -p "$LOG_DIR"

cmd_setup() {
  # TODO: bootstrap one-time tasks (pull env files, generate per-process configs, install deps).
  echo "TODO: implement setup"
}

cmd_up() {
  # TODO: start your full stack. Examples:
  #   docker-compose up -d
  #   nohup go run . > "$LOG_DIR/main.log" 2>&1 & echo $! > "$LOG_DIR/main.pid"
  #   nohup go run ./cmd/worker > "$LOG_DIR/worker.log" 2>&1 & echo $! > "$LOG_DIR/worker.pid"
  echo "TODO: implement up"
}

cmd_down() {
  # TODO: gracefully stop everything started by `up`. PID-file pattern works for `go run` + similar.
  # Recursive child-process kill (macOS lacks pkill --recursive):
  kill_tree() {
    local pid=$1 kid
    for kid in $(pgrep -P "$pid" 2>/dev/null); do kill_tree "$kid"; done
    kill "$pid" 2>/dev/null || true
  }
  for pidfile in "$LOG_DIR"/*.pid; do
    [[ -f "$pidfile" ]] || continue
    pid=$(cat "$pidfile")
    kill -0 "$pid" 2>/dev/null && kill_tree "$pid"
    rm -f "$pidfile"
  done
  # TODO: also stop containers, e.g. docker-compose down
}

cmd_status() {
  # TODO: report which processes are alive. Suggested: walk .dev-logs/*.pid + kill -0.
  echo "TODO: implement status"
}

cmd_logs() {
  local name=${1:-}
  [[ -n "$name" ]] || { echo "usage: $0 logs <name>" >&2; exit 1; }
  tail -f "$LOG_DIR/$name.log"
}

main() {
  local sub=${1:-help}
  shift || true
  case "$sub" in
    setup)  cmd_setup ;;
    up)     cmd_up ;;
    down)   cmd_down ;;
    status) cmd_status ;;
    logs)   cmd_logs "$@" ;;
    *)
      sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
      ;;
  esac
}

main "$@"
